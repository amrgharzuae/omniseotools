# ==============================================================================
# OmniSEOTools - Environment Variables Template
# Copy this file to .env.local and populate with your own keys/credentials.
# ==============================================================================

# Google Gemini API Key (Optional: for AI Meta Tag / SERP snippet generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional fallback: for AI Meta Tag generation)
# OPENAI_API_KEY=

# Google Analytics 4 Measurement ID (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID (Optional: for production ad units)
# NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX
